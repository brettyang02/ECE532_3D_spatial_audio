/*
 * helloworld.c: simple test application
 *
 * This application configures UART 16550 to baud rate 9600.
 * PS7 UART (Zynq) is not initialized by this application, since
 * bootrom/bsp configures it to baud rate 115200
 *
 * ------------------------------------------------
 * | UART TYPE   BAUD RATE                        |
 * ------------------------------------------------
 *   uartns550   9600
 *   uartlite    Configurable only in HW design
 *   ps7_uart    115200 (configured by bootrom/bsp)
 */
#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"

#include "xgpio.h"
#include "xuartlite_l.h"
#include "xparameters.h"

int main()
{
    init_platform();

    // 1. Initialize the GPIO using the ID from your xparameters.h
    XGpio angle_gpio;
    XGpio_Initialize(&angle_gpio, XPAR_GPIO_0_DEVICE_ID);
    XGpio_SetDataDirection(&angle_gpio, 1, 0x00); // Set Channel 1 as Output

    // 2. Initialize target_angle
    u8 current_angle = 0;
    XGpio_DiscreteWrite(&angle_gpio, 1, current_angle);

    print("--- Spatial Audio Control (Arrow Keys) ---\n\r");
    print("Use UP/RIGHT to increase (+1)\n\r");
    print("Use DOWN/LEFT to decrease (-1)\n\r");
    print("Press 'r' to reset to 0\n\r");

    while(1) {
        // Read the first byte from the terminal
        u8 byte1 = XUartLite_RecvByte(XPAR_UARTLITE_0_BASEADDR);

        // Check if the first byte is the ESC character (27 in decimal)
        if (byte1 == 27) {
            // Read the next two bytes of the escape sequence
            u8 byte2 = XUartLite_RecvByte(XPAR_UARTLITE_0_BASEADDR);
            u8 byte3 = XUartLite_RecvByte(XPAR_UARTLITE_0_BASEADDR);

            if (byte2 == '[') {
                if (byte3 == 'A' || byte3 == 'C') {
                    // 'A' is UP arrow, 'C' is RIGHT arrow
                    current_angle++;
                    xil_printf("Increased -> Target Angle: %d\n\r", current_angle);
                }
                else if (byte3 == 'B' || byte3 == 'D') {
                    // 'B' is DOWN arrow, 'D' is LEFT arrow
                    current_angle--;
                    xil_printf("Decreased -> Target Angle: %d\n\r", current_angle);
                }
            }
        }
        // Optional: Catch a regular character like 'r' to reset
        else if (byte1 == 'r' || byte1 == 'R') {
            current_angle = 0;
            xil_printf("Reset   -> Target Angle: %d\n\r", current_angle);
        }

        // Send the updated 8-bit value to your Verilog IP
        XGpio_DiscreteWrite(&angle_gpio, 1, current_angle);
    }

    cleanup_platform();
    return 0;
}
