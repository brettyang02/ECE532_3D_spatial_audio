#include <stdio.h>
#include <stdlib.h>     // Required for abs()
#include "platform.h"
#include "xil_printf.h"
#include "PmodGYRO.h"
#include "xparameters.h"

PmodGYRO myGyro;

// ==========================================
// CUSTOM FIX: SPI Polling Function
// Bypasses the dead physical INT2 pin and reads the
// sensor's STATUS_REG (0x27) directly over SPI.
// ==========================================
int isDataReady(PmodGYRO *InstancePtr) {
    uint8_t status = 0;
    GYRO_ReadReg(InstancePtr, 0x27, &status, 1);

    // Check if Bit 3 (0x08) ZYXDA is high
    if ((status & 0x08) != 0) {
        return 1; // True, data is ready
    } else {
        return 0; // False, waiting on data
    }
}
// ==========================================

int main() {
    init_platform();

    // 1. Initialize variables correctly
    float angleX = 0.0, angleY = 0.0, angleZ = 0.0;
    float dt = 0.01; // 100Hz Output Data Rate = 0.01 seconds per sample

    print("\n\r--- Nexys PmodGYRO Demo (2000 dps Mode) ---\n\r");

    GYRO_bool status = GYRO_begin(
        &myGyro,
        XPAR_PMODGYRO_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODGYRO_0_AXI_LITE_GPIO_BASEADDR
    );

    if (status != GYRO_true) {
        print("Error: PmodGYRO initialization failed!\n\r");
        cleanup_platform();
        return -1;
    }

    // ==========================================
    // CONFIGURE FOR 2000 DPS RANGE
    // ==========================================
    // Register 0x23 is CTRL_REG4.
    // Writing 0x20 sets the FS bits to '10' (2000 dps)
    uint8_t scale_2000 = 0x20;
    GYRO_WriteReg(&myGyro, 0x23, &scale_2000, 1);
    print("Gyroscope scaled to +/- 2000 dps!\n\r");

    // ==========================================
    // OPTIMIZATION: Startup Calibration Routine
    // ==========================================
    print("Calibrating... DO NOT MOVE BOARD\n\r");
    int32_t offsetX = 0, offsetY = 0, offsetZ = 0;
    int samples = 100;

    for (int i = 0; i < samples; i++) {
        while(isDataReady(&myGyro) == 0) {}
        offsetX += GYRO_getX(&myGyro);
        offsetY += GYRO_getY(&myGyro);
        offsetZ += GYRO_getZ(&myGyro);
    }
    offsetX /= samples;
    offsetY /= samples;
    offsetZ /= samples;
    print("Calibration Complete!\n\r");
    // ==========================================

    // State tracker to prevent "double dipping" the same data point
    int prevDataReady = 0;

    // Main Integration Loop
    while (1) {
        if (isDataReady(&myGyro) == 1) {

            // 1. Read Raw and Subtract the startup offset
            int16_t rawX = GYRO_getX(&myGyro) - offsetX;
            int16_t rawY = GYRO_getY(&myGyro) - offsetY;
            int16_t rawZ = GYRO_getZ(&myGyro) - offsetZ;

            // 2. Convert to degrees per second using the new 2000 dps sensitivity
            // divided by 2 to reflect correct angle changes
            float vX = rawX * 0.070 / 2;
            float vY = rawY * 0.070 / 2;
            float vZ = rawZ * 0.070 / 2;

            // 3. Integrate (Slightly higher deadband to account for wider scale noise)
            if (abs(rawX) > 15) angleX += (vX * dt);
            if (abs(rawY) > 15) angleY += (vY * dt);
            if (abs(rawZ) > 15) angleZ += (vZ * dt);

            // 4. Format for printing
            int32_t printAngleX = (int32_t)(angleX * 100);
            int32_t printAngleY = (int32_t)(angleY * 100);
            int32_t printAngleZ = (int32_t)(angleZ * 100);
            int8_t tempF = GYRO_getTemp(&myGyro);

            xil_printf("Angle X: %05d | Y: %05d | Z: %05d | Temp: %dF \r",
                       printAngleX, printAngleY, printAngleZ, tempF);
        }
    }

    cleanup_platform();
    return 0;
}
