#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#include "sleep.h"
#include "PmodJSTK2.h"
#include "PmodGYRO.h"
#include "xuartlite_l.h"

// ==========================================
// GLOBAL INSTANCES
// ==========================================
PmodJSTK2 joystick;
PmodGYRO myGyro;
XGpio angle_gpio;   // AXI_GPIO_0 (Outputs)
XGpio switch_gpio;  // AXI_GPIO_1 (Inputs)

// Gyro Integration Variables
float angleX = 0.0, angleY = 0.0, angleZ = 0.0;
int32_t offsetX = 0, offsetY = 0, offsetZ = 0;
float dt = 0.01;

// ==========================================
// GYRO SPI POLLING BYPASS
// ==========================================
int isDataReady(PmodGYRO *InstancePtr) {
    uint8_t status = 0;
    GYRO_ReadReg(InstancePtr, 0x27, &status, 1);
    return ((status & 0x08) != 0) ? 1 : 0;
}

int main() {
    init_platform();

    print("\n\r--- 3D Spatial Audio Control (Merged Mode) ---\n\r");
    print("Toggle SW0 to switch modes.\n\r");
    print("Mode 0: Gyroscope (Z = Azimuth, X = Elevation)\n\r");
    print("Mode 1: Joystick/UART (Joystick = Azimuth, Keyboard = Elevation)\n\r");
    print("> ");

    // 1. Initialize Outputs to Spatial Audio
    XGpio_Initialize(&angle_gpio, XPAR_GPIO_0_DEVICE_ID);
    XGpio_SetDataDirection(&angle_gpio, 1, 0x00); // Channel 1: Angle
    XGpio_SetDataDirection(&angle_gpio, 2, 0x00); // Channel 2: Elevation

    // 2. Initialize Switch Input
    XGpio_Initialize(&switch_gpio, XPAR_GPIO_1_DEVICE_ID);

    // 3. Initialize Joystick
    JSTK2_begin(&joystick, XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR, XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR);

    // 4. Initialize Gyro
    GYRO_begin(&myGyro, XPAR_PMODGYRO_0_AXI_LITE_SPI_BASEADDR, XPAR_PMODGYRO_0_AXI_LITE_GPIO_BASEADDR);
    uint8_t scale_2000 = 0x20;
    GYRO_WriteReg(&myGyro, 0x23, &scale_2000, 1);

    // ==========================================
    // GYRO CALIBRATION
    // ==========================================
    print("\n\rCalibrating Gyro... DO NOT MOVE BOARD\n\r");
    int samples = 100;
    for (int i = 0; i < samples; i++) {
        while(isDataReady(&myGyro) == 0) {}
        offsetX += GYRO_getX(&myGyro);
        offsetY += GYRO_getY(&myGyro);
        offsetZ += GYRO_getZ(&myGyro);
    }
    offsetX /= samples;
    offsetY /= samples;
    offsetZ /= samples;
    print("Calibration Complete!\n\r> ");

    // Initial State Variables
    u8 current_angle_index = 0;
    u8 current_elevation_index = 1; // Default 0 degrees
    XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);
    XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

    u32 uart_base_addr = XPAR_UARTLITE_0_BASEADDR;
    char input_buffer[10];
    int buffer_index = 0;
    int prevDataReady = 0;

    // ==========================================
    // MAIN LOOP
    // ==========================================
    while (1) {
        // Read SW0 to determine mode
        int all_switches = XGpio_DiscreteRead(&switch_gpio, 1);
        int mode = all_switches & 0x01;

        if (isDataReady(&myGyro)) {
			int16_t rawX = GYRO_getX(&myGyro) - offsetX;
			int16_t rawY = GYRO_getY(&myGyro) - offsetY;
			int16_t rawZ = GYRO_getZ(&myGyro) - offsetZ;

			// Should be 0.07 in ideal cases
			// 0.007 * 0.5 * 0.75 = 0.02625 is the experimental correct value when constantly accessing UART
			float magic_multiplier = 0.02625;
			float vX = rawX * magic_multiplier;
			float vY = rawY * magic_multiplier;
			float vZ = rawZ * magic_multiplier;

			if (abs(rawX) > 15) angleX += (vX * dt);
			if (abs(rawY) > 15) angleY += (vY * dt);
			if (abs(rawZ) > 15) angleZ += (vZ * dt);
        }


        if (mode == 0) {
            // --------------------------------------
            // MODE 0: GYROSCOPE
            // --------------------------------------

        	// Integer Conversion

        	int printAngleX = (int)(angleX * 10);
        	int printAngleY = (int)(angleY * 10);
        	int printAngleZ = (int)(angleZ * 10);

			// --- MAPPING Z TO AZIMUTH (5 degree steps) ---
        	int wrapped_Z = printAngleZ;
			while (wrapped_Z < 0) wrapped_Z += 360;
			while (wrapped_Z >= 360) wrapped_Z -= 360;

			int new_angle_index = (wrapped_Z / 5);
			if (new_angle_index >= 72) new_angle_index = 0;

			// --- MAPPING X TO ELEVATION (-30, 0, 30, 60, 90) ---
			// Gyro is flipped in terms of angle for application
			int new_elev_index = 1; // Default 0
			if      (printAngleX >=  30) new_elev_index = 0; // -30
			else if (printAngleX >=   0) new_elev_index = 1; // 0
			else if (printAngleX >= -30) new_elev_index = 2; // 30
			else if (printAngleX >= -60) new_elev_index = 3; // 60
			else if (printAngleX >= -90) new_elev_index = 4; // 90

			// Update Hardware if values changed
			if (new_elev_index != current_elevation_index || new_angle_index != current_angle_index) {
				current_angle_index = new_angle_index;
				current_elevation_index = new_elev_index;
				XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);
				XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

				xil_printf("\r[GYRO] Azimuth Idx: %2d | Elev Idx: %d \n\r> ", current_angle_index, current_elevation_index);
			}

			xil_printf("Angle X: %05d | Y: %05d | Z: %05d \r", printAngleX, printAngleY, printAngleZ);

        } else {
            // --------------------------------------
            // MODE 1: JOYSTICK & UART
            // --------------------------------------

            // --- UART ELEVATION ---
            if (!XUartLite_IsReceiveEmpty(uart_base_addr)) {
                u8 key_input = XUartLite_RecvByte(uart_base_addr);

                if (key_input == '\r' || key_input == '\n') {
                    if (buffer_index > 0) {
                        input_buffer[buffer_index] = '\0';
                        int parsed_elevation = atoi(input_buffer);
                        int valid = 1;
                        u8 new_elevation_index = current_elevation_index;

                        if      (parsed_elevation == -30) new_elevation_index = 0;
                        else if (parsed_elevation ==   0) new_elevation_index = 1;
                        else if (parsed_elevation ==  30) new_elevation_index = 2;
                        else if (parsed_elevation ==  60) new_elevation_index = 3;
                        else if (parsed_elevation ==  90) new_elevation_index = 4;
                        else {
                            xil_printf("\n\rError: %d is not a supported elevation!\n\r", parsed_elevation);
                            valid = 0;
                        }

                        if (valid && (new_elevation_index != current_elevation_index)) {
                            current_elevation_index = new_elevation_index;
                            XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);
                            xil_printf("\n\rSuccess! Elevation changed to %d (Index %d)\n\r", parsed_elevation, current_elevation_index);
                        } else if (valid) {
                            xil_printf("\n\rElevation is already %d.\n\r", parsed_elevation);
                        }
                        buffer_index = 0;
                        print("> ");
                    }
                }
                else if (key_input == 8 || key_input == 127) {
                    if (buffer_index > 0) {
                        buffer_index--;
                        outbyte(8); outbyte(' '); outbyte(8);
                    }
                }
                else if ((key_input >= '0' && key_input <= '9') || key_input == '-') {
                    if (buffer_index < 9) {
                        input_buffer[buffer_index] = key_input;
                        buffer_index++;
                        outbyte(key_input);
                    }
                }
            }

            // --- JOYSTICK AZIMUTH ---
            JSTK2_Position position = JSTK2_getPosition(&joystick);
            float dx = 0.0;
            float dy = 0.0;

            if (position.XData >= 192) dx = (float)(position.XData - 192) / 63.0;
            else dx = (float)(position.XData - 192) / 192.0;

            if (position.YData >= 192) dy = (float)(position.YData - 192) / 63.0;
            else dy = (float)(position.YData - 192) / 192.0;

            if (fabs(dx) > 0.1 || fabs(dy) > 0.1) {
                float angle_rad = atan2(dx, -dy);
                float angle_deg = angle_rad * (180.0 / M_PI);

                if (angle_deg < 0) angle_deg += 360.0;

                int new_angle_index = (int)(angle_deg / 5.0);
                if (new_angle_index >= 72) new_angle_index = 0;

                if (new_angle_index != current_angle_index) {
                    current_angle_index = (u8)new_angle_index;
                    XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);

                    xil_printf("\r                            \r[JSTK] Angle: %3d deg -> Index: %2d\n\r> ", (int)angle_deg, current_angle_index);
                    for(int i=0; i < buffer_index; i++){
                        outbyte(input_buffer[i]);
                    }
                }
            }
        }
    }

    cleanup_platform();
    return 0;
}

