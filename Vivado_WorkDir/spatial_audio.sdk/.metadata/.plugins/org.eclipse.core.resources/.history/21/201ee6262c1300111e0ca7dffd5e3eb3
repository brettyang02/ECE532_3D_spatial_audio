#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#include "sleep.h"
#include "PmodJSTK2.h"

PmodJSTK2 joystick;
XGpio angle_gpio;

int main_2() {
    init_platform();

    print("--- Spatial Audio Control (Joystick) ---\n\r");

    // 1. Initialize the GPIO that connects to your Verilog target_angle
    XGpio_Initialize(&angle_gpio, XPAR_GPIO_0_DEVICE_ID);
    XGpio_SetDataDirection(&angle_gpio, 1, 0x00);

    // 2. Initialize the Pmod Joystick
    JSTK2_begin(
        &joystick,
        XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR
    );

    // Set initial angle to 0 degrees (Index 0)
    u8 current_angle_index = 0;
    XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);

    while (1) {
        // Read raw joystick data
        JSTK2_Position position = JSTK2_getPosition(&joystick);

        float dx = 0.0;
        float dy = 0.0;

        // Asymmetric X-Axis Scaling (Center = 192)
        if (position.XData >= 192) {
            dx = (float)(position.XData - 192) / 63.0;
        } else {
            dx = (float)(position.XData - 192) / 192.0;
        }

        // Asymmetric Y-Axis Scaling (Center = 192)
        if (position.YData >= 192) {
            dy = (float)(position.YData - 192) / 63.0;
        } else {
            dy = (float)(position.YData - 192) / 192.0;
        }

        // Scaled Deadzone Check (ignore minor accidental bumps)
        if (fabs(dx) > 0.1 || fabs(dy) > 0.1) {

            // Calculate angle in radians, then convert to degrees
            float angle_rad = atan2(dx, -dy);
            float angle_deg = angle_rad * (180.0 / M_PI);

            // Wrap negative angles to 0-360 range
            if (angle_deg < 0) {
                angle_deg += 360.0;
            }

            // Convert degrees (0-360) to your hardware index (0-71)
            // 360 degrees / 72 indices = exactly 5 degrees per index
            int new_angle_index = (int)(angle_deg / 5.0);

            // Safety clamp: If angle exactly hits 360.0, math yields 72. Map it to 0.
            if (new_angle_index >= 72) {
                new_angle_index = 0;
            }

            // Only write to hardware and print if the angle actually changed
            // This prevents flooding the GPIO and the UART console
            if (new_angle_index != current_angle_index) {
                current_angle_index = (u8)new_angle_index;
                XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);

                xil_printf("Moved! Angle: %3d deg -> Hardware Index: %2d\r\n", (int)angle_deg, current_angle_index);
            }
        }

        // Sleep for 50ms (Poll at 20 Hz)
        usleep(50000);
    }

    cleanup_platform();
    return 0;
}
