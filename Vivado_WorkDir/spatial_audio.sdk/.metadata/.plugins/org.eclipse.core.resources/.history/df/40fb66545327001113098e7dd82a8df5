#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include <string.h>
#include "platform.h"
#include "xil_printf.h"
#include "xgpio.h"
#include "xparameters.h"
#include "sleep.h"
#include "PmodJSTK2.h"
#include "PmodGYRO.h"
#include "xuartlite_l.h"

// ==========================================
// TUNING CONSTANTS
// ==========================================
const float AZIMUTH_SENSITIVITY = 1.0f;
const float ELEVATION_SENSITIVITY = 1.0f;
#define DISPLAY_GPIO_ID XPAR_GPIO_2_DEVICE_ID

// ==========================================
// GLOBAL INSTANCES
// ==========================================
PmodJSTK2 joystick_azi;   // Joystick 1 (Azimuth)
PmodJSTK2 joystick_elev;  // Joystick 2 (Elevation)
PmodGYRO myGyro;
XGpio angle_gpio;         // GPIO 0: Output to Custom IP (Ch 1 = Azi, Ch 2 = Elev)
XGpio input_gpio;         // GPIO 1: Input from Board SW/BTNS (Ch 1 = SW, Ch 2 = BTNS)
XGpio display_gpio;       // GPIO 2: Output to 7-Segment Display

// Gyro Integration Variables
float angleX = 0.0, angleY = 0.0, angleZ = 0.0;
int32_t offsetX = 0, offsetY = 0, offsetZ = 0;
float dt = 0.01;

// --- 7-SEGMENT MULTIPLEXING DATA ---
// Active-Low Lookup Table (0=ON, 1=OFF)
u8 seg_map[12] = {
    0xC0, // 0
    0xF9, // 1
    0xA4, // 2
    0xB0, // 3
    0x99, // 4
    0x92, // 5
    0x82, // 6
    0xF8, // 7
    0x80, // 8
    0x90, // 9
    0xBF, // 10: '-' (Minus Sign)
    0xFF  // 11: Blank (All Off)
};

// This array holds the 8 characters currently being shown on the board.
// Index 0 is the right-most digit, Index 7 is the left-most digit.
u8 display_buffer[8] = {0, 0, 0, 11, 11, 0, 0, 0};

int isDataReady(PmodGYRO *InstancePtr) {
    uint8_t status = 0;
    GYRO_ReadReg(InstancePtr, 0x27, &status, 1);
    return ((status & 0x08) != 0) ? 1 : 0;
}

// Reusable Reset Function
void reset_audio(u8 *azi_idx, u8 *elev_idx, int buffer_index, char* input_buffer) {
    angleX = 0.0;
    angleZ = 0.0;
    *azi_idx = 0;
    *elev_idx = 3;
    XGpio_DiscreteWrite(&angle_gpio, 1, *azi_idx);
    XGpio_DiscreteWrite(&angle_gpio, 2, *elev_idx);

    int real_azi = *azi_idx * 5;
    int real_elev = (*elev_idx * 10) - 30;

    xil_printf("\r                                                                      \r\n[SYSTEM] HARDWARE RESET! Azimuth %d (index %d) | Elevation %d (index %d)\n\r> ",
               real_azi, *azi_idx, real_elev, *elev_idx);

    // Redraw whatever user was typing in UART
    for(int i=0; i < buffer_index; i++){
        outbyte(input_buffer[i]);
    }
}

int main() {
    init_platform();

    print("\n\r--- 3D Spatial Audio Control (Full Sphere) ---\n\r");
    print("HW CONTROLS: SW0 (Up = Gyro, Down = Joystick) | BTNC (Reset)\n\r");
    print("UART overrides are still active.\n\r> ");

    // Initialize Outputs to Custom IP
    XGpio_Initialize(&angle_gpio, XPAR_GPIO_0_DEVICE_ID);
    XGpio_SetDataDirection(&angle_gpio, 1, 0x00);
    XGpio_SetDataDirection(&angle_gpio, 2, 0x00);

    // Initialize Inputs (SW on Ch1, BTNS on Ch2)
    // Note: Verify XPAR_GPIO_1_DEVICE_ID matches your xparameters.h
    XGpio_Initialize(&input_gpio, XPAR_GPIO_1_DEVICE_ID);
    XGpio_SetDataDirection(&input_gpio, 1, 0xFFFFFFFF); // All inputs
    XGpio_SetDataDirection(&input_gpio, 2, 0xFFFFFFFF); // All inputs

    // Initialize PMODs
    JSTK2_begin(&joystick_azi, XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR, XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR);
    JSTK2_begin(&joystick_elev, XPAR_PMODJSTK2_1_AXI_LITE_SPI_BASEADDR, XPAR_PMODJSTK2_1_AXI_LITE_GPIO_BASEADDR);

    GYRO_begin(&myGyro, XPAR_PMODGYRO_0_AXI_LITE_SPI_BASEADDR, XPAR_PMODGYRO_0_AXI_LITE_GPIO_BASEADDR);
    uint8_t scale_2000 = 0x20;
    GYRO_WriteReg(&myGyro, 0x23, &scale_2000, 1);

    // Initialize 7-Segment Display (GPIO 2)
    XGpio_Initialize(&display_gpio, DISPLAY_GPIO_ID);
    XGpio_SetDataDirection(&display_gpio, 1, 0x00);
    XGpio_SetDataDirection(&display_gpio, 2, 0x00);
    XGpio_DiscreteWrite(&display_gpio, 2, 0xFF); // Turn it all off for now

    print("\n\rCalibrating Gyro... DO NOT MOVE BOARD\n\r");
    int samples = 100;
    for (int i = 0; i < samples; i++) {
        while(isDataReady(&myGyro) == 0) {}
        offsetX += GYRO_getX(&myGyro);
        offsetY += GYRO_getY(&myGyro);
        offsetZ += GYRO_getZ(&myGyro);
    }
    offsetX /= samples;
    offsetY /= samples;
    offsetZ /= samples;
    print("Calibration Complete!\n\r> ");

    u8 current_angle_index = 0;
    u8 current_elevation_index = 3;
    XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);
    XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

    int current_mode = 1; // 1 = Joystick, 0 = Gyro
    int last_mode = -1;

    u32 uart_base_addr = XPAR_UARTLITE_0_BASEADDR;
    char input_buffer[16];
    int buffer_index = 0;

    while (1) {

        // --------------------------------------
        // 1. HARDWARE INPUTS (SW0 & BTNC)
        // --------------------------------------
        u32 sw_state = XGpio_DiscreteRead(&input_gpio, 1);
        u32 btn_state = XGpio_DiscreteRead(&input_gpio, 2);

        // SW0: Bit 0 of Channel 1
        current_mode = (sw_state & 0x01) ? 0 : 1;

        // BTNC: Bit 0 of Channel 2
        if (btn_state & 0x01) {
            reset_audio(&current_angle_index, &current_elevation_index, buffer_index, input_buffer);
            usleep(200000); // Debounce to prevent multiple triggers
        }

        if (current_mode != last_mode) {
            if (current_mode == 0) {
                angleX = 0.0; angleZ = 0.0;
                xil_printf("\r\r\n[SYSTEM] Switched to GYRO Mode! (Board Zeroed)\n\r> ");
            } else {
                xil_printf("\r\r\n[SYSTEM] Switched to JOYSTICK Mode!\n\r> ");
            }
            last_mode = current_mode;

            for(int i=0; i < buffer_index; i++){
                outbyte(input_buffer[i]);
            }
        }

        // --------------------------------------
        // 2. UART COMMANDS (Legacy Fallback)
        // --------------------------------------
        if (!XUartLite_IsReceiveEmpty(uart_base_addr)) {
            u8 key_input = XUartLite_RecvByte(uart_base_addr);

            if (key_input == '\r' || key_input == '\n') {
                if (buffer_index > 0) {
                    input_buffer[buffer_index] = '\0';

                    if (strcmp(input_buffer, "reset") == 0) {
                        reset_audio(&current_angle_index, &current_elevation_index, 0, input_buffer);
                    }
                    else {
                        if (current_mode == 1) {
                            int parsed_elevation = atoi(input_buffer);

                            if (parsed_elevation >= -30 && parsed_elevation <= 90 && (parsed_elevation % 10 == 0)) {
                                u8 new_elevation_index = (parsed_elevation + 30) / 10;

                                if (new_elevation_index != current_elevation_index) {
                                    current_elevation_index = new_elevation_index;
                                    XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

                                    int real_azi = current_angle_index * 5;
                                    xil_printf("\n\rSuccess! Azimuth angle %d (index %d) | Elevation angle %d (index %d)\n\r",
                                               real_azi, current_angle_index, parsed_elevation, current_elevation_index);
                                } else {
                                    xil_printf("\n\rElevation is already %d.\n\r", parsed_elevation);
                                }
                            } else {
                                xil_printf("\n\rError: %d is invalid! Must be between -30 and 90 in steps of 10.\n\r", parsed_elevation);
                            }
                        } else {
                            xil_printf("\n\r[SYSTEM] Keyboard elevation is disabled in Gyro mode.\n\r");
                        }
                    }
                    buffer_index = 0;
                    print("> ");
                }
            }
            else if (key_input == 8 || key_input == 127) {
                if (buffer_index > 0) {
                    buffer_index--;
                    outbyte(8); outbyte(' '); outbyte(8);
                }
            }
            else if ((key_input >= '0' && key_input <= '9') || key_input == '-' || (key_input >= 'a' && key_input <= 'z')) {
                if (buffer_index < 15) {
                    input_buffer[buffer_index] = key_input;
                    buffer_index++;
                    outbyte(key_input);
                }
            }
        }

        // --------------------------------------
        // 3. ALWAYS INTEGRATE GYRO
        // --------------------------------------
        if (isDataReady(&myGyro)) {
            int16_t rawX = GYRO_getX(&myGyro) - offsetX;
            int16_t rawY = GYRO_getY(&myGyro) - offsetY;
            int16_t rawZ = GYRO_getZ(&myGyro) - offsetZ;

            float magic_multiplier = AZIMUTH_SENSITIVITY / 16.0f;
            float vX = rawX * magic_multiplier;
            float vY = rawY * magic_multiplier;
            float vZ = rawZ * magic_multiplier * 1.5f * 1.05f;

            if (abs(rawX) > 15) angleX += (vX * dt);
            if (abs(rawY) > 15) angleY -= (vY * dt);
            if (abs(rawZ) > 15) angleZ -= (vZ * dt);
        }

        // --------------------------------------
        // 4. APPLY CURRENT AZIMUTH & ELEVATION CONTROL
        // --------------------------------------
        if (current_mode == 0) {
            // =========================
            // MODE 0: GYROSCOPE
            // =========================
            int printAngleZ = (int)(angleZ * 10);
            int wrapped_Z = printAngleZ;
            while (wrapped_Z < 0) wrapped_Z += 360;
            while (wrapped_Z >= 360) wrapped_Z -= 360;

            int new_angle_index = (wrapped_Z / 5);
            if (new_angle_index >= 72) new_angle_index = 0;

            int raw_elev_index = (int)round(-angleX / ELEVATION_SENSITIVITY) + 3;

            if (raw_elev_index < 0) raw_elev_index = 0;
            if (raw_elev_index > 12) raw_elev_index = 12;
            int new_elev_index = raw_elev_index;

            if (new_angle_index != current_angle_index || new_elev_index != current_elevation_index) {
                current_angle_index = new_angle_index;
                current_elevation_index = new_elev_index;

                XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);
                XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

                int real_azi = current_angle_index * 5;
                int real_elev = (current_elevation_index * 10) - 30;

                xil_printf("\r                                                                      \r[GYRO] Azimuth angle %3d (index %2d) | Elevation angle %3d (index %2d)\n\r> ",
                           real_azi, current_angle_index, real_elev, current_elevation_index);
                for(int i=0; i < buffer_index; i++){
                    outbyte(input_buffer[i]);
                }
            }
        }
        else {
            // =========================
            // MODE 1: DUAL JOYSTICKS
            // =========================

            // --- AZIMUTH (Joystick 1) ---
            JSTK2_Position pos_azi = JSTK2_getPosition(&joystick_azi);
            float dx = 0.0;
            float dy_azi = 0.0;

            if (pos_azi.XData >= 192) dx = (float)(pos_azi.XData - 192) / 63.0;
            else dx = (float)(pos_azi.XData - 192) / 192.0;

            if (pos_azi.YData >= 192) dy_azi = (float)(pos_azi.YData - 192) / 63.0;
            else dy_azi = (float)(pos_azi.YData - 192) / 192.0;

            int new_angle_index = current_angle_index;

            if (fabs(dx) > 0.1 || fabs(dy_azi) > 0.1) {
                float angle_rad = atan2(dy_azi, dx);
                float angle_deg = angle_rad * (180.0 / M_PI);

                if (angle_deg < 0) angle_deg += 360.0;

                new_angle_index = (int)(angle_deg / 5.0);
                if (new_angle_index >= 72) new_angle_index = 0;
            }

            // --- ELEVATION (Joystick 2 - X Axis Mapping) ---
            JSTK2_Position pos_elev = JSTK2_getPosition(&joystick_elev);
            float dx_elev = 0.0;

            if (pos_elev.XData >= 192) dx_elev = (float)(pos_elev.XData - 192) / 63.0;
            else dx_elev = (float)(pos_elev.XData - 192) / 192.0;

            int new_elev_index = 3; // Default to Middle (0 degrees / index 3)

            // Asymmetric absolute mapping to center 0 using the X axis (INVERTED DIRECTION)
            if (dx_elev < -0.1) {
                // Pushed Left: Map -0.1 to -1.0 to Index 3 to 12 (0 to 90 degrees)
                new_elev_index = 3 + (int)round(dx_elev * -9.0);
            }
            else if (dx_elev > 0.1) {
                // Pushed Right: Map 0.1 to 1.0 to Index 3 to 0 (0 to -30 degrees)
                new_elev_index = 3 + (int)round(dx_elev * -3.0);
            }

            // Clamp bounds
            if (new_elev_index < 0) new_elev_index = 0;
            if (new_elev_index > 12) new_elev_index = 12;

            // --- UPDATE STATE & OUTPUT ---
            if (new_angle_index != current_angle_index || new_elev_index != current_elevation_index) {
                current_angle_index = (u8)new_angle_index;
                current_elevation_index = (u8)new_elev_index;

                XGpio_DiscreteWrite(&angle_gpio, 1, current_angle_index);
                XGpio_DiscreteWrite(&angle_gpio, 2, current_elevation_index);

                int real_azi = current_angle_index * 5;
                int real_elev = (current_elevation_index * 10) - 30;

                xil_printf("\r                                                                      \r[JSTK] Azimuth angle %3d (index %2d) | Elevation angle %3d (index %2d)\n\r> ",
                           real_azi, current_angle_index, real_elev, current_elevation_index);

                for(int i=0; i < buffer_index; i++){
                    outbyte(input_buffer[i]);
                }
            }
        }

        usleep(50000); // 50ms loop
    }

    cleanup_platform();
    return 0;
}
