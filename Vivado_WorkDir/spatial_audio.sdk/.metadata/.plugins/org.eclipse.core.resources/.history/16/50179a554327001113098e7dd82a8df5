int isDataReady(PmodGYRO *InstancePtr) {
    uint8_t status = 0;
    GYRO_ReadReg(InstancePtr, 0x27, &status, 1);
    return ((status & 0x08) != 0) ? 1 : 0;
}

// ==========================================
// BCD FORMATTER FOR 7-SEGMENT DISPLAY
// ==========================================
u32 FormatFor7Segment(int azimuth, int elevation) {
    u32 azi_bcd = 0;
    u32 elev_bcd = 0;
    int shift, val;

    // --- Format Azimuth (e.g., 355 -> 0x0355) ---
    val = azimuth;
    shift = 0;
    while (val > 0 && shift < 16) {
        azi_bcd |= (val % 10) << shift;
        val /= 10;
        shift += 4;
    }

    // --- Format Elevation (e.g., -30 -> 0xA030) ---
    int is_neg = 0;
    if (elevation < 0) {
        is_neg = 1;
        val = -elevation;
    } else {
        val = elevation;
    }

    shift = 0;
    while (val > 0 && shift < 16) {
        elev_bcd |= (val % 10) << shift;
        val /= 10;
        shift += 4;
    }

    // Negative sign mapped to 'A'
    if (is_neg) {
        elev_bcd |= (0xA << 12);
    }

    // Combine: Azimuth on left, Elevation on right (0x0355A030)
    return (azi_bcd << 16) | elev_bcd;
}

// Reusable Reset Function
void reset_audio(u8 *azi_idx, u8 *elev_idx, int buffer_index, char* input_buffer) {
    angleX = 0.0;
    angleZ = 0.0;
    *azi_idx = 0;
    *elev_idx = 3;
    XGpio_DiscreteWrite(&angle_gpio, 1, *azi_idx);
    XGpio_DiscreteWrite(&angle_gpio, 2, *elev_idx);

    int real_azi = *azi_idx * 5;
    int real_elev = (*elev_idx * 10) - 30;

    // Push reset values to 7-segment display
    u32 display_output = FormatFor7Segment(real_azi, real_elev);
    XGpio_DiscreteWrite(&display_gpio, 1, display_output);

    xil_printf("\r                                                                      \r\n[SYSTEM] HARDWARE RESET! Azimuth %d (index %d) | Elevation %d (index %d)\n\r> ",
               real_azi, *azi_idx, real_elev, *elev_idx);

    // Redraw whatever user was typing in UART
    for(int i=0; i < buffer_index; i++){
        outbyte(input_buffer[i]);
    }
}

