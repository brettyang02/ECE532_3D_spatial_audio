#include "PmodJSTK2.h"
#include "xparameters.h"
#include "sleep.h"

PmodJSTK2 joystick;

// Moving these OUTSIDE of main() makes them Global!
// They will never disappear from the debugger now.
volatile int x_pos = 0;
volatile int y_pos = 0;

int main() {
    JSTK2_begin(
        &joystick,
        XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR
    );

    while (1) {
        JSTK2_Position position = JSTK2_getPosition(&joystick);

        x_pos = position.XData;
        y_pos = position.YData;

        usleep(50000);
    }
    return 0;
}
