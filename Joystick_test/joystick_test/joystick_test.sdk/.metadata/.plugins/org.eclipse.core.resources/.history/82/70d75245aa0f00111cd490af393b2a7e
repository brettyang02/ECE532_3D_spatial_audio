#include "PmodJSTK2.h"
#include "xparameters.h"
#include "sleep.h"
#include "xil_printf.h"
#include <math.h>

PmodJSTK2 joystick;

// Left as global in case you still need to use the Expressions tab
volatile int current_angle_int = 0;

int main() {
    JSTK2_begin(
        &joystick,
        XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR
    );

    while (1) {
        JSTK2_Position position = JSTK2_getPosition(&joystick);

        float dx = 0.0;
        float dy = 0.0;

        // 1. Asymmetric X-Axis Scaling (Center = 192)
        // Maps 0-255 to a clean -1.0 to 1.0 range
        if (position.XData >= 192) {
            dx = (float)(position.XData - 192) / 63.0;  // 63 is (255 - 192)
        } else {
            dx = (float)(position.XData - 192) / 192.0;
        }

        // 2. Asymmetric Y-Axis Scaling (Center = 192)
        // Maps 0-255 to a clean -1.0 to 1.0 range
        if (position.YData >= 192) {
            dy = (float)(position.YData - 192) / 63.0;
        } else {
            dy = (float)(position.YData - 192) / 192.0;
        }

        // 3. Scaled Deadzone Check
        // If the stick hasn't moved at least 10% (0.1) from center, ignore it.
        // We use fabs() to check the absolute value of the float.
        if (fabs(dx) > 0.1 || fabs(dy) > 0.1) {

            // 4. Coordinate System Rotation
            // dx first, and -dy second, sets 0 degrees to Top and rotates Clockwise.
            float angle_rad = atan2(dx, -dy);
            float angle_deg = angle_rad * (180.0 / M_PI);

            // Wrap negative angles to 0-360 range
            if (angle_deg < 0) {
                angle_deg += 360.0;
            }

            // Cast to int for standard MicroBlaze printing
            current_angle_int = (int)angle_deg;

            xil_printf("Angle: %3d degrees\r\n", current_angle_int);
        }

        usleep(50000);
    }
    return 0;
}
