#include "PmodJSTK2.h"
#include "xparameters.h"
#include "sleep.h"

PmodJSTK2 joystick;

int main() {
    // Initialize the joystick using the hardware addresses from Vivado
    JSTK2_begin(
        &joystick,
        XPAR_PMODJSTK2_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODJSTK2_0_AXI_LITE_GPIO_BASEADDR
    );

    // Volatile variables ensure the debugger can see them update in real-time
    volatile int x_pos = 0;
    volatile int y_pos = 0;

    // Main polling loop
    while (1) {
        // Fetch only the X and Y struct
        JSTK2_Position position = JSTK2_getPosition(&joystick);

        // Update the variables
        x_pos = position.XData;
        y_pos = position.YData;

        // Brief 50ms pause to stabilize the polling rate
        usleep(50000);
    }
    return 0;
}
