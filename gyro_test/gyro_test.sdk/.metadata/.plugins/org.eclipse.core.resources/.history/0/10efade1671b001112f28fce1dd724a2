#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "PmodGYRO.h"
#include "sleep.h"
#include "xparameters.h"

// The instance of your PmodGYRO driver
PmodGYRO myGyro;

int main() {
    init_platform();

    print("\n\r--- Nexys DDR4 PmodGYRO Demo ---\n\r");

    /* * GYRO_begin(InstancePtr, SPI_Address, GPIO_Address)
     * These constants are defined in your xparameters.h file.
     * Ensure these names match what Vivado generated for your block design.
     */
    GYRO_bool status = GYRO_begin(
        &myGyro,
        XPAR_PMODGYRO_0_AXI_LITE_SPI_BASEADDR,
        XPAR_PMODGYRO_0_AXI_LITE_GPIO_BASEADDR
    );

    if (status != GYRO_true) {
        print("Error: PmodGYRO initialization failed!\n\r");
        cleanup_platform();
        return -1;
    }

    print("Success! Reading rotation and temperature data...\n\r");
    print("Move your board to see value changes.\n\r");

    float angleX, angleY, angleZ = 0;
    float dt = 0.1; // Your usleep(100000) is 0.1 seconds

    while (1) {
        // Read raw angular velocity for X, Y, and Z
        int16_t rawX = GYRO_getX(&myGyro);
        int16_t rawY = GYRO_getY(&myGyro);
        int16_t rawZ = GYRO_getZ(&myGyro);

        // 1. Convert
        float vX = rawX * 0.00875;
        float vY = rawY * 0.00875;
        float vZ = rawZ * 0.00875;

        // 2. Integrate: New Angle = Old Angle + (Velocity * Time)
        if (abs(rawX) > 50) { // Threshold
            angleX = angleX + (vX * dt);
        }

        if (abs(rawY) > 70) { // Threshold
             angleY = angleY + (vY * dt);
        }

        if (abs(rawZ) > 50) {
        	angleZ = angleZ + (vZ * dt);
        }

        int32_t printAngleX = (int32_t)(angleX * 100);
        int32_t printAngleY = (int32_t)(angleY * 100);
        int32_t printAngleZ = (int32_t)(angleZ * 100);

        // Read the temperature (converted to Fahrenheit by the driver)
        int8_t tempF = GYRO_getTemp(&myGyro);

        // Check if data is ready using the Int2 status (Bit 1 of GPIO)
        GYRO_bool dataReady = GYRO_Int2Status(&myGyro);

        // Print values to the Serial Terminal
        xil_printf("Angle X: %05d | Angle Y: %05d | Angle Z: %05d | Temp: %dF | Ready: %d\r",
        		printAngleX, printAngleY, printAngleZ, tempF, dataReady);

        // 100ms delay (10Hz refresh rate)
        usleep(100000);
    }

    cleanup_platform();
    return 0;
}
